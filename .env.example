# Copy to .env for local testing. Actual .env files are excluded from Git and VSIX.
# GitHub Actions injects these values; the runner ignores the default .env in CI.
VERTEX_LIVE_PROJECT_ID=YOUR_GOOGLE_CLOUD_PROJECT_ID
VERTEX_LIVE_EXPECTED_ACCOUNT=YOUR_ADC_ACCOUNT_EMAIL
# Absolute path to an existing ADC file; leave empty for SDK ambient ADC.
# In CI, google-github-actions/auth supplies GOOGLE_APPLICATION_CREDENTIALS.
VERTEX_LIVE_ADC_FILE=
VERTEX_LIVE_REGION=global
VERTEX_LIVE_GEMINI_MODEL=gemini-3.8-flash
VERTEX_LIVE_CLAUDE_MODEL=claude-haiku-5-5
VERTEX_LIVE_REQUEST_TIMEOUT_SECONDS=90
VERTEX_LIVE_HOST_TIMEOUT_SECONDS=900
VERTEX_LIVE_VSCODE_VERSION=1.110.0
