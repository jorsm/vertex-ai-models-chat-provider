{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Vertex AI Models Chat Provider \u2014 Model Catalog",
    "description": "Catalog of candidate models and prioritized GCP regions for the Google Agent Platform for Copilot Chat extension. A custom copy of this file (workspace `.vscode/models.json` or user-level) fully replaces the bundled catalog. Resolution precedence: Workspace > User > Bundled.",
    "type": "object",
    "additionalProperties": false,
    "required": ["candidateModels", "regionPriority"],
    "properties": {
        "candidateModels": {
            "type": "array",
            "description": "Array of model definitions to probe during discovery. Only models that respond in the first matching region become available in the Copilot Chat picker.",
            "items": {
                "$ref": "#/definitions/ModelSpec"
            }
        },
        "regionPriority": {
            "type": "array",
            "description": "Ordered list of GCP regions to probe (e.g. \"global\", \"us-east5\"). Discovery stops at the first region where at least one model responds.",
            "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
            },
            "examples": [["global", "us-east5", "europe-west1", "asia-southeast1"]]
        }
    },
    "definitions": {
        "ModelSpec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "vendor", "displayName", "family", "version", "maxInputTokens", "maxOutputTokens", "capabilities", "pricing"],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for the model, used by VS Code and the extension to reference it.",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[a-zA-Z0-9_.@-]+$"
                },
                "vendor": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Provider identifier used to dispatch inference to a registered adapter (for example, \"google\", \"anthropic\", or \"grok\"). An unregistered provider produces an inference error.",
                    "maxLength": 256,
                    "pattern": "^[a-zA-Z0-9_.@-]+$"
                },
                "displayName": {
                    "type": "string",
                    "description": "Human-readable name shown in the Copilot Chat model picker.",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                },
                "family": {
                    "type": "string",
                    "description": "Model family (e.g. \"gemini\", \"claude\", \"grok\").",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                },
                "version": {
                    "type": "string",
                    "description": "The specific API version/model name sent to Vertex AI. For Grok this is the xAI model path (for example, \"xai/grok-4.6\"). Slash-separated namespaces are allowed; URLs, absolute paths, empty segments and dot segments are invalid.",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^(?!\\.{1,2}(?:/|$))[a-zA-Z0-9_.@-]+(?:/(?!\\.{1,2}(?:/|$))[a-zA-Z0-9_.@-]+)*$"
                },
                "maxInputTokens": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Maximum allowed input tokens for the model.",
                    "maximum": 9007199254740991
                },
                "maxOutputTokens": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Maximum allowed output tokens for the model.",
                    "maximum": 9007199254740991
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["imageInput", "toolCalling"],
                    "properties": {
                        "imageInput": {
                            "type": "boolean",
                            "description": "Whether the model accepts image inputs (vision)."
                        },
                        "toolCalling": {
                            "type": "boolean",
                            "description": "Whether the model supports tool/function calling."
                        }
                    }
                },
                "pricing": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["input", "output"],
                    "properties": {
                        "input": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Cost per 1 million input tokens (USD)."
                        },
                        "output": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Cost per 1 million output tokens (USD)."
                        },
                        "cache_read": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Optional cost per 1 million cached tokens read."
                        },
                        "cache_create": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Optional cost per 1 million cached tokens written."
                        },
                        "longContext": {
                            "type": "object",
                            "description": "Optional rate card used when the complete input context is larger than inputThresholdTokens. Every token in that request uses these rates.",
                            "additionalProperties": false,
                            "required": ["inputThresholdTokens", "input", "output"],
                            "properties": {
                                "inputThresholdTokens": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "description": "Use this rate card only when total input, cached input, and cache writes exceed this many tokens.",
                                    "maximum": 9007199254740991
                                },
                                "input": {
                                    "type": "number",
                                    "minimum": 0,
                                    "description": "Long-context cost per 1 million input tokens (USD)."
                                },
                                "output": {
                                    "type": "number",
                                    "minimum": 0,
                                    "description": "Long-context cost per 1 million output tokens (USD)."
                                },
                                "cache_read": {
                                    "type": "number",
                                    "minimum": 0,
                                    "description": "Optional long-context cost per 1 million cached tokens read."
                                },
                                "cache_create": {
                                    "type": "number",
                                    "minimum": 0,
                                    "description": "Optional long-context cost per 1 million cached tokens written."
                                }
                            }
                        }
                    }
                },
                "effort": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["values", "default"],
                    "description": "Named effort choices and a default from that list. The vendor adapter maps the value to its API; the API validates model support.",
                    "properties": {
                        "values": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                            }
                        },
                        "default": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Default effort sent when no saved model preference is present. Must belong to values.",
                            "pattern": "\\S"
                        }
                    }
                }
            }
        }
    },
    "if": {
        "properties": {
            "candidateModels": {
                "type": "array",
                "minItems": 1
            }
        }
    },
    "then": {
        "properties": {
            "regionPriority": {
                "type": "array",
                "minItems": 1
            }
        }
    }
}
